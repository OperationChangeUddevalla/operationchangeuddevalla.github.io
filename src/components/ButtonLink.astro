---
interface Props {
	text: string;
	href?: string;
	inverse?: boolean;
}

const { text, href = "#", inverse = false } = Astro.props;
---

<a
	class="inline-block cursor-pointer rounded px-8 py-4 text-2xl"
	class:list={[
		{ "bg-ukraine-blue text-white": !inverse },
		{ "text-ukraine-blue bg-white": inverse },
	]}
	href={href}
>
	{text}
</a>
