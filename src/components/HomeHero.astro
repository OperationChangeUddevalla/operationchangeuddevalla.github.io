---
import { Image } from "astro:assets";
---

<header class="relative h-screen">
	<div class="absolute left-0 top-0 flex h-full w-full justify-center">
		<div class="grid-rows-hero grid max-w-xl items-center px-2 text-center">
			<div class="row-start-2">
				<h1 class="flex flex-col gap-4">
					<div>
						<span
							class="text-ukraine-blue text-shadow block text-4xl font-bold md:text-5xl"
						>
							Stöd Ukraina Gruppen
						</span>
					</div>
					<span class="text-1xl text-ukraine-blue block md:text-2xl">
						i samarbete med
					</span>
					<div
						class="text-ukraine-yellow text-shadow flex flex-col text-2xl md:text-3xl"
					>
						<span>Lions Uddevalla</span>
						<span>Lions Vänersborg</span>
						<span>Ukrainas vänner Uddevalla</span>
						<span>Ukrainska Föreningen Fyrbodal</span>
						<span>Tjernobylkommitten</span>
					</div>
				</h1>
			</div>
			<div class="row-start-3 flex justify-center self-start">
				<img
					class="w-32 md:w-48"
					src="sponsors/lu_yellow.png"
					alt="Lions Uddevalla"
					width="192"
				/>
			</div>
		</div>
	</div>
	<figure class="bg-hero-gradient relative -z-10 h-full w-full">
		<Image
			class="h-full w-full object-cover mix-blend-multiply blur-sm"
			src={import("../assets/hero.jpg")}
			loading="eager"
			alt="Hero"
		/>
	</figure>
</header>
