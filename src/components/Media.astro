---
import { Image } from "astro:assets";
import { getMedia } from "../lib/media";

interface Props {
	path: string;
	imageClass?: string;
	videoClass?: string;
	fit?: "cover" | "contain";
	preload?: "metadata" | "auto" | "none";
	files?: Record<string, { class?: string; contain?: boolean }>;
}

const {
	path,
	imageClass,
	videoClass,
	fit = "cover",
	preload = "metadata",
	files,
} = Astro.props;

const media = getMedia(path);

const basename = (key: string) => key.split("/").pop() ?? "";
const objectClass = (name: string) =>
	files?.[name]?.contain || fit === "contain"
		? "object-contain"
		: "object-cover";
---

<Fragment>
	{
		Object.entries(media.images).map(([key, loader]) => {
			const name = basename(key);
			return (
				<Image
					src={loader()}
					alt={media.metadata.files?.[name]?.alt ?? ""}
					class="h-full w-full"
					class:list={[imageClass, files?.[name]?.class, objectClass(name)]}
				/>
			);
		})
	}
	{
		Object.entries(media.videos).map(async ([key, loader]) => {
			const name = basename(key);
			return (
				<video
					preload={preload}
					controls
					aria-label={media.metadata.files?.[name]?.label}
					class="h-full w-full"
					class:list={[videoClass, files?.[name]?.class, objectClass(name)]}
				>
					<source src={(await loader()).default} />
				</video>
			);
		})
	}
</Fragment>
