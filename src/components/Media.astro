---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export type ImageAssets = typeof imageAssets;
export type VideoAssets = typeof videoAssets;

interface Props {
	path: string;
}

const { path } = Astro.props;

const pathFilter = new RegExp(path);

const assets = import.meta.glob<{ default: string }>("/src/assets/**/*.*");
let test = Object.keys(assets).some((asset) => pathFilter.test(asset));
if (!test) {
	throw new Error(`${path}`);
}

const imageAssets = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/**/*.{avif,png,webp,jpeg,jpg,svg}",
);
const videoAssets = import.meta.glob<{ default: string }>(
	"/src/assets/**/*.mp4",
);

let filteredImages = Object.keys(imageAssets).filter((image) =>
	pathFilter.test(image),
);

let pathFilteredImages: ImageAssets = {};
filteredImages.forEach(
	(image) => (pathFilteredImages[image] = imageAssets[image]),
);

let filteredVideos = Object.keys(videoAssets).filter((video) =>
	pathFilter.test(video),
);
let pathFilteredVideos: VideoAssets = {};
filteredVideos.forEach(
	(video) => (pathFilteredVideos[video] = videoAssets[video]),
);

// https://docs.astro.build/en/recipes/dynamically-importing-images/.
// https://github.com/rollup/plugins/tree/master/packages/dynamic-import-vars#limitations.
// https://github.com/vitejs/vite/issues/4945.
---

{
	Astro.slots.has("default") && (
		<Fragment
			set:html={Astro.slots.render("default", [
				pathFilteredImages,
				pathFilteredVideos,
			])}
		/>
	)
}

{
	!Astro.slots.has("default") && (
		<Fragment>
			{Object.keys(imageAssets).map((image) => {
				if (pathFilter.test(image)) {
					return (
						<Image
							src={imageAssets[image]()}
							alt=""
							class="h-full w-full object-cover"
						/>
					);
				}
			})}
			{Object.keys(videoAssets).map(async (video) => {
				if (pathFilter.test(video)) {
					return (
						<video
							preload="metadata"
							controls
							class="h-full w-full object-cover"
						>
							<source src={(await videoAssets[video]()).default} />
						</video>
					);
				}
			})}
		</Fragment>
	)
}
