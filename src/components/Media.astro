---
import { Image } from "astro:assets";
import { getMedia, type Media } from "../lib/media";

interface Props {
	media?: Media;
	path?: string;
	imageClass?: string;
	videoClass?: string;
	fit?: "cover" | "contain";
	preload?: "metadata" | "auto" | "none";
	files?: Record<string, { class?: string; contain?: boolean }>;
}

const {
	media: mediaProp,
	path,
	imageClass,
	videoClass,
	fit = "cover",
	preload = "metadata",
	files,
} = Astro.props;

let media: Media;
if (mediaProp) {
	media = mediaProp;
} else if (path) {
	media = getMedia(path);
} else {
	throw new Error("<Media> requires a media or path prop");
}

const basename = (key: string) => key.split("/").pop() ?? "";
const objectClass = (name: string) =>
	files?.[name]?.contain || fit === "contain"
		? "object-contain"
		: "object-cover";
---

<Fragment>
	{
		Object.entries(media.images).map(([key, loader]) => {
			const name = basename(key);
			return (
				<Image
					src={loader()}
					alt={media.meta.files?.[name]?.alt ?? ""}
					class="h-full w-full"
					class:list={[imageClass, files?.[name]?.class, objectClass(name)]}
				/>
			);
		})
	}
	{
		Object.entries(media.videos).map(async ([key, loader]) => {
			const name = basename(key);
			return (
				<video
					preload={preload}
					controls
					aria-label={media.meta.files?.[name]?.label}
					class="h-full w-full"
					class:list={[videoClass, files?.[name]?.class, objectClass(name)]}
				>
					<source src={(await loader()).default} />
				</video>
			);
		})
	}
</Fragment>
