---
import Media from "../components/Media.astro";
import Section from "../components/Section.astro";
import TabView from "../components/TabView.astro";
import type { Tab } from "../components/TabView.astro";

export const ID_GALLERY = "galleri";

interface Gallery {
	title: string;
	assets: {
		path: string;
		title?: string;
		usePathTailAsTitle?: boolean;
		span?: boolean;
	}[];
}

interface Props {
	galleries: Gallery[];
}

const { galleries } = Astro.props;

const tabs: Tab[] = galleries.map((gallery, i) => {
	return { title: gallery.title, target: i.toString() };
});

const pathTail = /\/([^\/]+)\/$/;
---

<Section id={ID_GALLERY} divide={false}>
	<TabView tabs={tabs} class="mb-12 border-b border-b-blue-200">
		{
			galleries.map((gallery, i) => (
				<div data-target={i} class="tab-view flex flex-col gap-16">
					{gallery.assets.map((asset) => (
						<div>
							{(asset.title || asset.usePathTailAsTitle) && (
								<p class="mb-4 border-b border-b-slate-200 p-4 text-center">
									{asset.title ?? asset.path.match(pathTail)?.[1]}
								</p>
							)}
							<div
								class="grid auto-rows-[400px] gap-2 md:auto-rows-[500px]"
								class:list={
									asset.span ? "grid-cols-1" : "md:grid-cols-2 lg:grid-cols-3"
								}
							>
								<Media path={asset.path} />
							</div>
						</div>
					))}
				</div>
			))
		}
	</TabView>
</Section>
