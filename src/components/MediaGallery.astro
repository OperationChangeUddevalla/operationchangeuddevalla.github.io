---
import Media from "./Media.astro";
import { getMedia } from "../lib/media";

export interface Gallery {
	assets: {
		path: string;
		title?: string;
		span?: boolean;
		files?: Record<string, { class?: string; contain?: boolean }>;
	}[];
}

interface Props {
	galleries: Gallery[];
}

const { galleries } = Astro.props;
---

<Fragment>
	{
		galleries.map((gallery, i) => (
			<div data-target={i} class="tab-view flex flex-col gap-16">
				{gallery.assets.map((asset) => (
					<div>
						{asset.title && (
							<p class="mb-4 border-b border-b-slate-200 p-4 text-center">
								{asset.title}
							</p>
						)}
						<div
							class="grid auto-rows-100 gap-2 md:auto-rows-125"
							class:list={
								asset.span ? "grid-cols-1" : "md:grid-cols-2 lg:grid-cols-3"
							}
						>
							<Media media={getMedia(asset.path)} files={asset.files} />
						</div>
					</div>
				))}
			</div>
		))
	}
</Fragment>
