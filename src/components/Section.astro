---
interface Props {
	title?: string;
	id?: string;
	bg?: string;
	divide?: boolean;
	contentClass?: string;
}

const { title, id, bg, divide = true, contentClass } = Astro.props;

const hasHeading = Astro.slots.has("heading") || !!title;
---

<section id={id} class="px-8 py-32" class:list={bg}>
	<div
		class="mx-auto max-w-7xl"
		class:list={[{ "divide-y divide-blue-200": divide }, contentClass]}
	>
		{
			hasHeading && (
				<header class="text-5xl">
					{Astro.slots.has("heading") && <slot name="heading" />}
					{!Astro.slots.has("heading") && title && (
						<h2 class="font-heading text-ukraine-blue mb-4 text-center">
							{title}
						</h2>
					)}
				</header>
			)
		}
		<slot name="after-header" />
		<slot name="content">
			<div class="pt-4 text-xl text-gray-800">
				<slot />
			</div>
		</slot>
	</div>
</section>
