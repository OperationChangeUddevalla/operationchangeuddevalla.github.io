---
import { Image } from "astro:assets";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import { ID_CONTACT } from "../layouts/Layout.astro";

interface Props {
	bg: string;
	title: string;
	loading?: "lazy" | "eager";
}

const { bg, title, loading = "lazy" } = Astro.props;
---

<Section bg={bg} title={title}>
	<div slot="after-header" class="p-4">
		<Image
			loading={loading}
			class="h-80 w-full object-cover"
			src={import("../assets/orphanage.webp")}
			alt="Barnhemmet"
		/>
	</div>
	<div class="flex flex-col gap-4">
		<slot name="text" />
		<div>
			<Button text="Bidra" href={`#${ID_CONTACT}`} />
		</div>
	</div>
	<slot />
</Section>
