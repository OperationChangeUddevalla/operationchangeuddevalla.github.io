---
import { Font } from "astro:assets";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import FloatingDonate from "../components/FloatingDonate.astro";
import Footer from "../components/Footer.astro";
import type { Nav as NavItem } from "../routes";

interface Props {
	title: string;
	nav: NavItem;
}

const { title, nav } = Astro.props;
---

<script
	is:inline
	data-goatcounter="https://sugaid.goatcounter.com/count"
	async
	src="//gc.zgo.at/count.js"></script>

<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<meta
			name="description"
			content="Vi är volontärer inom hjälporganisationen Lions Club Uddevalla som hjälper gamla och barn på barnhem i Ukraina."
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<Font cssVariable="--font-inter" preload={[{ subset: "latin" }]} />
		<Font cssVariable="--font-oswald" preload={[{ subset: "latin" }]} />

		<title>{`${title} - Stöd Ukraina Gruppen`}</title>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>

	<body>
		<Nav nav={nav} />
		<FloatingDonate />
		<slot />
		<Footer />
		<style>
			::-webkit-scrollbar {
				display: none;
			}
		</style>
	</body>
</html>
