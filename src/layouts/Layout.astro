---
import "@fontsource-variable/inter";
import "@fontsource-variable/oswald";

export enum Nav {
	Home = "Hem",
	Orphanage = "Barnhemmet",
	SocialCenter = "Sociala Centret",
	Trips = "Resor",
	Gallery = "Galleri",
	Contact = "Kontakta",
}

export const ROUTE_HOME = "/";
export const ROUTE_ORPHANAGE = "/barnhemmet";
export const ROUTE_SOCIAL_CENTER = "/sociala-centret";
export const ROUTE_TRIPS = "/resor";
export const ROUTE_GALLERY = "/galleri";

export const ID_CONTACT = "kontakta";
export const ID_DONATE = "donera";

interface Props {
	title: string;
	nav: Nav;
}

const { title, nav } = Astro.props;
---

<script>
	const nav = document.querySelector("nav");
	const navButton = nav?.querySelector("button");

	const menu = "menu";

	function toggleScrolled() {
		const scrolled = "scrolled";
		if (window.scrollY === 0 && !navButton?.classList.contains(menu)) {
			nav?.classList.remove(scrolled);
		} else {
			nav?.classList.add(scrolled);
		}
	}

	addEventListener("scroll", (_event) => {
		toggleScrolled();
	});

	nav?.addEventListener("click", (event) => {
		event.stopPropagation();
	});

	navButton?.addEventListener("click", (_event) => {
		navButton.classList.toggle(menu);
		toggleScrolled();
	});

	document.addEventListener("click", (_event) => {
		navButton?.classList.remove(menu);
		toggleScrolled();
	});

	toggleScrolled();

	const donate = document.querySelector("#donera");
	const floatingDonate = document.querySelector(".floating-donate");
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				floatingDonate?.classList.add("opacity-0", "pointer-events-none");
			} else {
				floatingDonate?.classList.remove("opacity-0", "pointer-events-none");
			}
		});
	});
	if (donate) {
		observer.observe(donate);
	}
</script>

<script
	is:inline
	data-goatcounter="https://sugaid.goatcounter.com/count"
	async
	src="//gc.zgo.at/count.js"></script>

<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<meta
			name="description"
			content="Vi är volontärer inom hjälporganisationen Lions Club Uddevalla som hjälper gamla och barn på barnhem i Ukraina."
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{`${title} - Stöd Ukraina Gruppen`}</title>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>

	<body>
		<nav class="group/nav fixed z-10 w-full">
			<div
				class="border-b-4 border-b-transparent p-4 uppercase transition-colors group-[.scrolled]/nav:scrolled-nav group-[.scrolled]/nav:shadow-xl"
			>
				<button class="group peer relative flex h-[32px] w-[32px] md:hidden">
					<svg
						class="absolute scale-100 fill-white transition-all group-[.menu]:scale-0 group-[.scrolled]/nav:fill-ukraine-blue"
						width="32"
						height="32"
						viewBox="0 -960 640 640"
						xmlns="http://www.w3.org/2000/svg"
						><path
							d="m 0,-320 v -80 h 640 v 80 z m 0,-280 v -80 h 640 v 80 z m 0,-280 v -80 h 640 v 80 z"
						></path></svg
					>
					<svg
						class="absolute scale-0 fill-white transition-all group-[.menu]:scale-100 group-[.scrolled]/nav:fill-ukraine-blue"
						width="32"
						height="32"
						viewBox="0 -960 560 560"
						xmlns="http://www.w3.org/2000/svg"
						><path
							d="M 56,-400 0,-456 224,-680 0,-904 l 56,-56 224,224 224,-224 56,56 -224,224 224,224 -56,56 -224,-224 z"
						></path></svg
					>
				</button>
				<ul
					class="hidden flex-col items-start gap-4 text-xl peer-[.menu]:mt-4 peer-[.menu]:flex md:flex md:flex-row md:justify-center md:gap-8"
				>
					{
						Object.values(Nav).map((n) => {
							let href = ROUTE_HOME;
							switch (n) {
								case Nav.Home:
									href = ROUTE_HOME;
									break;
								case Nav.Orphanage:
									href = ROUTE_ORPHANAGE;
									break;
								case Nav.SocialCenter:
									href = ROUTE_SOCIAL_CENTER;
									break;
								case Nav.Trips:
									href = ROUTE_TRIPS;
									break;
								case Nav.Gallery:
									href = ROUTE_GALLERY;
									break;
								case Nav.Contact:
									href = `#${ID_CONTACT}`;
									break;
							}
							return (
								<li
									class:list={{
										"border-b-2 border-b-ukraine-yellow": nav === n,
									}}
									class="text-white transition-colors group-[.scrolled]/nav:border-b-ukraine-blue group-[.scrolled]/nav:text-black"
								>
									<a
										class="hover:text-ukraine-yellow group-[.scrolled]/nav:hover:text-ukraine-blue"
										href={href}
									>
										{n}
									</a>
								</li>
							);
						})
					}
				</ul>
			</div>
		</nav>

		<div
			class="floating-donate fixed bottom-2 right-2 z-10 hidden flex-row gap-2 text-center text-sm text-white transition-opacity sm:flex md:text-base 2xl:flex-col [@media(max-height:1024px)]:flex-row"
		>
			<div class="flex flex-col bg-gray-700 p-2">
				<img loading="lazy" class="w-32" src="/swish.jpg" alt="Donera" />
				<div class="flex h-full max-w-32 items-center justify-center p-2">
					<p>Barnhemmet Ukraina</p>
				</div>
			</div>
		</div>

		<slot />

		<footer class="bg-gray-800 px-8 py-32 text-white">
