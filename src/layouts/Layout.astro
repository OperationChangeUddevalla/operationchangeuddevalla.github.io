				class="mx-auto grid max-w-screen-xl justify-center gap-16 md:grid-cols-2 md:justify-items-center"
			>
				<div id={ID_CONTACT}>
					<h2 class="mb-8 font-heading text-5xl">Kontakta</h2>
					<div class="flex flex-col gap-8 text-xl">
						<div>
