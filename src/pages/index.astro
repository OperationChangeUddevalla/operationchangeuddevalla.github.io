---

<script>
	if (window.navigator.pdfViewerEnabled) {
		let t = document.querySelector("#operation-change");
		t?.classList.add("pdfViewerEnabled");
	}
</script>

<Layout title="Hem" nav={Nav.Home}>
	<main>
		<header class="relative h-screen">
			<div class="absolute left-0 top-0 flex h-full w-full justify-center">
				<div class="grid max-w-xl grid-rows-hero items-center px-2 text-center">
					<div class="row-start-2">
						<h1 class="flex flex-col items-center gap-4">
							<div class="">
								<span
									class="block text-4xl font-bold text-ukraine-blue text-shadow md:text-5xl"
									>Stöd Ukraina Gruppen</span
								>
							</div>
							<span class="text-1xl block text-[#006FC7] md:text-2xl"
								>i samarbete med</span
							>
							<div class="text-ukraine-yellow">
								<span class="block text-3xl text-shadow md:text-4xl"
									>Lions Uddevalla</span
								>
							</div>
						</h1>
					</div>
					<div class="row-start-3 flex justify-center self-start">
						<img
							class="w-32 md:w-48"
							src="sponsors/lu.png"
							alt="Lions Uddevalla"
							width="192"
						/>
					</div>
				</div>
			</div>
			<figure class="relative -z-10 h-full w-full bg-hero-gradient">
				<Image
					class="h-full w-full object-cover mix-blend-multiply blur-sm"
					src={import("../assets/hero.jpg")}
					loading="eager"
					alt="Hero"
				/>
			</figure>
		</header>

		<SectionOrphanage bg="bg-white" title="Dzhulinsky Orphanage House">
			<OrphanageText slot="text" />
		</SectionOrphanage>

		<Section title="Bobbans resor" bg="bg-gray-50">
			<div class="mb-8 text-center">
				<div class="mb-4 text-center">
					<Link
						text="Senaste: 19/9 - 2025"
						href={`${ROUTE_TRIPS}#${ID_GALLERY}`}
					/>
				</div>

				<MediaCarousel
					path="../assets/trips/2025-09_now/2025-09-19/"
					height="h-[800px]"
				>
					<Image
						src={import("../assets/trips/2025-04_2025-08/2025-04-25/01.jpg")}
						alt=""
						class="media h-full w-full object-cover"
					/>
				</MediaCarousel>
			</div>
		</Section>

		<Section
			title="Volontär"
			bg="bg-ukraine-blue"
			divide={false}
			class="grid place-items-center gap-8 md:grid-cols-[1fr_2fr]"
		>
			<h2 slot="heading" class="text-white">Volontär</h2>
			<div slot="content" class="text-center text-xl text-white md:text-left">
				<p class="mb-4">
					Om du vill hjälpa till med renoveringen av barnhemmet som volontär och
					är beredd att tillbringa två till tre veckor i Ukraina, kontakta oss
					så hjälper vi dig med ansökan.
				</p>
				<Button text="Kontakta oss" href={`#${ID_CONTACT}`} inverse={true} />
			</div>
		</Section>

		<Section title="Sponsorer" bg="bg-blue-50">
			<div class="flex flex-wrap place-content-center gap-4 pb-8 pt-4">
				<a
					class="flex w-fit max-w-md place-items-center gap-6 rounded border-2 border-solid border-[#0866ff]/25 bg-[#0866ff]/25 p-4 shadow-md hover:border-[#0866ff]/75"
					href="https://www.facebook.com/groups/25916426878004538/"
				>
					<img
						loading="lazy"
						class="w-8 object-contain"
						width={32}
						height={32}
						src="/facebook.png"
						alt="Facebook-gruppen Stöd Ukraina"
					/>
					<div>
						<p class="text-3xl">Stöd Ukraina Gruppen</p>
						<p class="text-base text-gray-600">Uddevalla</p>
					</div>
				</a>
				<a
					class="flex w-fit max-w-md rounded border-2 border-solid border-[#00539b]/25 bg-[#00539b]/25 p-4 shadow-md hover:border-[#00539b]/75"
					href="https://lionsuddevalla.se/"
				>
					<Image
						class="w-16 object-contain md:h-24 md:w-24"
						width={96}
						height={96}
						src="/sponsors/lu.png"
						alt="Lions Uddevalla"
					/>
				</a>
			</div>

			<div
				class="flex flex-wrap justify-center gap-4 border-t border-t-blue-200 p-8"
			>
				<a
					class="flex w-fit max-w-md place-items-center gap-6 rounded border-2 border-solid border-[#ed1c24]/25 bg-[#ed1c24]/25 p-4 shadow-md hover:border-[#ed1c24]/75"
					href="https://www.vansterpartiet.se/"
				>
					<img
						loading="lazy"
						class="w-16 md:h-24 md:w-24"
						src="/sponsors/v.svg"
						alt="Vänsterpartiet"
					/>
					<div>
						<p class="text-base text-gray-600">Vänsterpartiet Uddevalla</p>
					</div>
				</a>
				<a
					class="flex w-fit max-w-md place-items-center gap-6 rounded border-2 border-solid border-[#50bf61]/25 bg-[#50bf61]/25 p-4 shadow-md hover:border-[#50bf61]/75"
					href="https://veteranpoolen.se/"
				>
					<img
						loading="lazy"
						class="w-16 md:h-24 md:w-24"
						src="/sponsors/vp.svg"
						alt="Veteranpoolen"
					/>
				</a>
				<a
					class="flex w-fit max-w-md rounded border-2 border-solid border-[#0d0d0d]/25 bg-[#ffffff] p-4 shadow-md hover:border-[#0d0d0d]/75"
					href="https://www.proxnet.mk/mk/"
				>
					<img
						loading="lazy"
						class="w-16 object-contain md:h-24 md:w-24"
						width={96}
						height={96}
						src="/sponsors/proxnet.jpg"
						alt="PROXNet"
					/>
				</a>
				<a
					class="flex w-fit max-w-md rounded border-2 border-solid border-[#d80811]/25 bg-[#d80811]/25 p-4 shadow-md hover:border-[#d80811]/75"
					href="https://www.abf.se/"
				>
					<img
						loading="lazy"
						class="w-16 md:h-24 md:w-24"
						src="/sponsors/abf.svg"
						alt="ABF"
					/>
				</a>
			</div>

			<p class="border-t border-t-blue-200 p-8 text-center">
				🩵💛 Bengt Kallebo 🩵💛
			</p>

			<div
				class="flex flex-wrap justify-center gap-x-8 gap-y-4 border-t border-t-blue-200 p-8 text-center"
			>
				{publicSponsors.map((sponsor) => <p>{sponsor}</p>)}
			</div>

			<div
				class="flex flex-wrap justify-center gap-x-8 gap-y-4 border-t border-t-blue-200 pt-8 text-center"
			>
				{privateSponsors.map((sponsor) => <p>{sponsor}</p>)}
			</div>
		</Section>
	</main>
</Layout>
