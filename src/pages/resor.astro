---
import Layout from "../layouts/Layout.astro";
import { Nav } from "../routes";
import Hero from "../components/Hero.astro";
import TabbedMediaGallery from "../components/TabbedMediaGallery.astro";
import { trips, getDays } from "../lib/trips";

const dayOverrides: Record<
	string,
	{
		title?: string;
		span?: boolean;
		files?: Record<string, { class?: string; contain?: boolean }>;
	}
> = {
	"/src/assets/trips/2023-08_2023-10/final/": {
		title:
			"Även denna resa är slut. Nu tar vi ny sats i insamlingen, behovet har inte avtagit, snarare tvärtom. Bobban.",
		span: true,
	},
	"/src/assets/trips/2025-09_2025-09/2025-09-25/": {
		files: { "07.jpg": { class: "col-span-2" } },
	},
	"/src/assets/trips/2025-04_2025-08/2025-04-25/": {
		files: {
			"01.jpg": { class: "md:col-span-2 lg:col-span-3" },
			"02.jpeg": { class: "md:col-span-2", contain: true },
		},
	},
	"/src/assets/trips/renovate/": { title: "" },
};

const folderName = (path: string) =>
	path.replace(/\/$/, "").split("/").pop() ?? "";

const tabbedGalleries = trips.map((trip) => ({
	title: trip.title,
	galleries: [
		{
			assets: getDays(trip.path).map((path) => ({
				path,
				title: folderName(path),
				...dayOverrides[path],
			})),
		},
	],
}));
---

<Layout title="Resor" nav={Nav.Trips}>
	<main>
		<Hero
			title="Bobban och Olgas resor till Ukraina"
			image={import("../assets/trips/2023-11_2024-01/2024-01-01/1.webp")}
		/>
		<TabbedMediaGallery tabbedGalleries={tabbedGalleries} />
	</main>
</Layout>
